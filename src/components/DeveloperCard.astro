---
import { Icon } from 'astro-icon/components'
import { developer_list } from '../DeveloperList.astro'

interface Props {
	developer: string
}

const { developer } = Astro.props
const info = developer_list[developer]

const linkDefs = [
	{ key: 'website', label: 'Website', icon: 'mdi:web' },
	{ key: 'github', label: 'GitHub', icon: 'github' },
	{ key: 'linkedin', label: 'LinkedIn', icon: 'linkedin' },
	{ key: 'artstation', label: 'ArtStation', icon: 'artstation' },
	{ key: 'itch', label: 'itch.io', icon: 'itchio' },
] as const

const links = info
	? linkDefs.flatMap(({ key, label, icon }) =>
			info[key] ? [{ label, icon, href: info[key] as string }] : []
		)
	: []
---

{
	info ? (
		<span data-dev-modal>
			<button
				type="button"
				data-open
				class="cursor-pointer underline decoration-dashed underline-offset-4 decoration-primary/40 dark:decoration-primary-dark/40 hover:decoration-primary dark:hover:decoration-primary-dark transition-colors"
			>
				<slot />
			</button>

			<dialog
				aria-label={developer}
				class="m-auto w-[calc(100%-2rem)] max-w-md p-0 rounded-xl border border-border dark:border-border-dark bg-base dark:bg-base-dark text-foreground dark:text-foreground-dark shadow-xl backdrop:bg-crust/60 dark:backdrop:bg-crust-dark/70 backdrop:backdrop-blur-sm"
			>
				<div class="p-6 space-y-5">
					<div class="flex items-start justify-between gap-4">
						<div>
							<h3 class="text-2xl font-bold">{developer}</h3>
						</div>
						<form method="dialog">
							<button
								class="cursor-pointer p-1 rounded hover:bg-surface dark:hover:bg-surface-dark transition-colors"
								aria-label="Close"
							>
								<Icon name="mdi:close" size={24} aria-hidden="true" />
							</button>
						</form>
					</div>

					{links.length > 0 && (
						<ul class="flex flex-wrap gap-2" role="list">
							{links.map((l) => (
								<li>
									<a
										class="btn-secondary !px-3 !py-1.5 text-sm"
										href={l.href}
										target="_blank"
										rel="noopener noreferrer"
									>
										<Icon name={l.icon} size={18} aria-hidden="true" />
										{l.label}
									</a>
								</li>
							))}
						</ul>
					)}
				</div>
			</dialog>
		</span>
	) : (
		<slot />
	)
}

<script>
	document.querySelectorAll<HTMLElement>('[data-dev-modal]').forEach((root) => {
		const dialog = root.querySelector('dialog')!

		root.querySelector('[data-open]')!.addEventListener('click', () => dialog.showModal())

		// Backdrop click: the dialog has p-0, so a click only targets it directly on the backdrop
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) dialog.close()
		})
	})
</script>

<style is:global>
	dialog[open] {
		animation: fade-in 0.2s ease-out;
	}
	body:has(dialog[open]) {
		overflow: hidden;
	}
</style>