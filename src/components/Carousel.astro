---
import { Icon } from 'astro-icon/components'

interface Props {
	/** Accessible name of the carousel region */
	label: string
	/** Slides visible at once from `md` up. Always 1 below. */
	perView?: number
	class?: string
}

const { label, perView = 1, class: className } = Astro.props

const navBtn =
	'size-8 grid place-items-center rounded-full border border-border dark:border-border-dark text-foreground dark:text-foreground-dark cursor-pointer transition-colors duration-150 hover:border-primary dark:hover:border-primary-dark hover:text-primary dark:hover:text-primary-dark disabled:opacity-40 disabled:pointer-events-none'
---

<x-carousel
	class:list={['block', className]}
	style={`--per-view:${perView};--gap:1rem`}
	role="region"
	aria-roledescription="carousel"
	aria-label={label}
>
	<div
		data-track
		tabindex="0"
		role="group"
		aria-label="Slides"
		class="track relative flex overflow-x-auto snap-x snap-mandatory overscroll-x-contain"
	>
		<slot />
	</div>

	<div data-controls class="mt-1 flex items-center justify-between gap-4">
		<button type="button" data-prev aria-label="Previous slide" class={navBtn}>
			<Icon name="mdi:chevron-left" class="size-5" aria-hidden="true" />
		</button>

		<div data-dots class="flex items-center"></div>

		<button type="button" data-next aria-label="Next slide" class={navBtn}>
			<Icon name="mdi:chevron-right" class="size-5" aria-hidden="true" />
		</button>
	</div>

	<p data-status class="sr-only" aria-live="polite"></p>

	<!-- Cloned per step. Lives in markup so Astro's scope attribute and Tailwind both apply. -->
	<template data-dot>
		<button type="button" class="group size-6 grid place-items-center cursor-pointer">
			<span
				class="h-2 w-2 rounded-full bg-overlay-1 dark:bg-overlay-0-dark transition-all duration-200 group-aria-[current=true]:w-6 group-aria-[current=true]:bg-primary dark:group-aria-[current=true]:bg-primary-dark"
			></span>
		</button>
	</template>
</x-carousel>

<style>
	.track {
		gap: var(--gap);
		scrollbar-width: none;
	}
	.track::-webkit-scrollbar {
		display: none;
	}
	/* Slotted content isn't scoped, hence :global */
	.track > :global(*) {
		flex: 0 0 100%;
		min-width: 0;
		margin: 0;
		scroll-snap-align: start;
	}
	/* Typography's .prose gives img/figure ~2em vertical margin, which would
	   inflate the track. `.track img` (0,1,1) beats `.prose-xl :where(img)` (0,1,0). */
	.track :global(img),
	.track :global(figure) {
		margin-block: 0.5rem;
	}
	@media (min-width: 48rem) {
		.track > :global(*) {
			flex-basis: calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
		}
	}
</style>

<script>
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)')

	class Carousel extends HTMLElement {
		#ac = new AbortController()
		#ro?: ResizeObserver

		connectedCallback() {
			this.#ac = new AbortController()
			const { signal } = this.#ac

			const track = this.querySelector<HTMLElement>('[data-track]')!
			const controls = this.querySelector<HTMLElement>('[data-controls]')!
			const prev = this.querySelector<HTMLButtonElement>('[data-prev]')!
			const next = this.querySelector<HTMLButtonElement>('[data-next]')!
			const dotsEl = this.querySelector<HTMLElement>('[data-dots]')!
			const status = this.querySelector<HTMLElement>('[data-status]')!
			const dotTpl = this.querySelector<HTMLTemplateElement>('template[data-dot]')!
			const slides = Array.from(track.children) as HTMLElement[]

			if (slides.length < 2) {
				controls.hidden = true
				return
			}

			slides.forEach((slide, i) => {
				slide.setAttribute('role', 'group')
				slide.setAttribute('aria-roledescription', 'slide')
				slide.setAttribute('aria-label', `${i + 1} of ${slides.length}`)
			})

			let steps = 0
			let current = -1
			let dots: HTMLButtonElement[] = []

			// Needs `position: relative` on the track so offsetLeft is track-relative.
			const go = (i: number) => {
				const target = slides[Math.min(Math.max(i, 0), steps - 1)]
				track.scrollTo({
					left: target.offsetLeft,
					behavior: reduceMotion.matches ? 'auto' : 'smooth',
				})
			}

			const nearest = () => {
				const left = track.scrollLeft
				let best = 0
				let bestDist = Infinity
				slides.forEach((s, i) => {
					const d = Math.abs(s.offsetLeft - left)
					if (d < bestDist) {
						bestDist = d
						best = i
					}
				})
				// At max scroll the nearest slide can sit past the last reachable step
				return Math.min(best, steps - 1)
			}

			const update = () => {
				const i = nearest()
				if (i === current) return
				const first = current === -1
				current = i
				dots.forEach((d, j) =>
					j === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')
				)
				prev.disabled = i === 0
				next.disabled = i === steps - 1
				if (!first) status.textContent = `Slide ${i + 1} of ${slides.length}`
			}

			const build = (count: number) => {
				steps = count
				dots = Array.from({ length: count }, (_, i) => {
					const dot = dotTpl.content.firstElementChild!.cloneNode(true) as HTMLButtonElement
					dot.setAttribute('aria-label', `Go to slide ${i + 1}`)
					dot.addEventListener('click', () => go(i), { signal })
					return dot
				})
				dotsEl.replaceChildren(...dots)
			}

			// Slides per view depends on viewport, so derive the step count from layout
			const measure = () => {
				const w = slides[0].offsetWidth
				if (!w) return
				const gap = parseFloat(getComputedStyle(track).columnGap) || 0
				const visible = Math.max(1, Math.floor((track.clientWidth + gap + 1) / (w + gap)))
				const count = Math.max(1, slides.length - visible + 1)
				if (count !== steps) build(count)
				controls.hidden = count < 2
				current = -1
				update()
			}

			let raf = 0
			track.addEventListener(
				'scroll',
				() => {
					cancelAnimationFrame(raf)
					raf = requestAnimationFrame(update)
				},
				{ passive: true, signal }
			)

			prev.addEventListener('click', () => go(current - 1), { signal })
			next.addEventListener('click', () => go(current + 1), { signal })

			// Native arrow-key scrolling moves in ~40px steps and fights snapping
			track.addEventListener(
				'keydown',
				(e) => {
					if (e.target !== track) return
					const targets: Record<string, number> = {
						ArrowLeft: current - 1,
						ArrowRight: current + 1,
						Home: 0,
						End: steps - 1,
					}
					const t = targets[e.key]
					if (t === undefined) return
					e.preventDefault()
					go(t)
				},
				{ signal }
			)

			this.#ro = new ResizeObserver(measure)
			this.#ro.observe(track)
		}

		disconnectedCallback() {
			this.#ac.abort()
			this.#ro?.disconnect()
		}
	}

	customElements.define('x-carousel', Carousel)
</script>