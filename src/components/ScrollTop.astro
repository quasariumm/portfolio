---
import { Icon } from 'astro-icon/components'
---

<button
	type="button"
	id="scroll-to-top"
	aria-label="Back to top"
	inert
	class="fixed bottom-4 right-4 md:right-1/2 z-30 size-11 grid place-items-center rounded-full border border-border dark:border-border-dark bg-base/80 dark:bg-base-dark/80 backdrop-blur-sm text-foreground dark:text-foreground-dark shadow-sm cursor-pointer opacity-0 translate-y-2 transition-[opacity,translate,color,border-color] duration-200 data-visible:opacity-100 data-visible:translate-y-0 hover:text-primary dark:hover:text-primary-dark hover:border-primary dark:hover:border-primary-dark"
>
	<Icon name="mdi:arrow-up" class="size-5" aria-hidden="true" />
</button>

<script>
	const button = document.querySelector<HTMLButtonElement>('#scroll-to-top')!

	// `inert` keeps it out of the tab order and a11y tree while invisible
	const update = () => {
		const show = scrollY > innerHeight
		button.toggleAttribute('data-visible', show)
		button.inert = !show
	}

	let raf = 0
	const schedule = () => {
		cancelAnimationFrame(raf)
		raf = requestAnimationFrame(update)
	}

	addEventListener('scroll', schedule, { passive: true })
	addEventListener('resize', schedule)
	update()

	button.addEventListener('click', (e) => {
		// 'auto' defers to CSS scroll-behavior: smooth, or instant under reduced motion
		scrollTo({ top: 0, behavior: 'auto' })

		// The button goes inert at the top and drops focus. For keyboard users
		// (click with detail 0), restart at the top of the tab order instead.
		if (e.detail === 0) {
			document.querySelector<HTMLElement>('.skip-to-content')?.focus({ preventScroll: true })
		}
	})
</script>